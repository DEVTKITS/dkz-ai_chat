# DkZ NOUZ-Term — Ghostty. In ~/.config/ghostty/config eintragen (install.sh macht das NICHT von selbst).
# Das Theme selbst liegt nach install.sh unter ~/.config/ghostty/themes/dkz-master; Alternativen: dkz-light,
# dkz-contrast, dkz-control, dkz-content. Schlüssel nach der Ghostty-Doku; hier ist Ghostty nicht installiert,
# also nicht ausgeführt. Prüfen mit:  ghostty +validate-config
theme = dkz-master
font-family = JetBrains Mono
font-size = 13
window-padding-x = 12
window-padding-y = 8
cursor-style = block
